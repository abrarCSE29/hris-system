# Local Docker Postgres (docker compose up from repo root, or `npm run db:up`)
DATABASE_URL="postgresql://hris:hris@localhost:5433/hris"
DIRECT_URL="postgresql://hris:hris@localhost:5433/hris"
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Private AI service (see ai-service/). The token must match the AI service's AI_SERVICE_TOKEN.
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TOKEN=""
