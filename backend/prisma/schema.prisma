generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  HR_ADMIN
}

enum Country {
  BANGLADESH
  MALAYSIA
  SRI_LANKA
  CYPRUS
}

enum UserStatus {
  ACTIVE
  ON_PROBATION
  ON_NOTICE
}

enum RequestCategoryCode {
  IT_EQUIPMENT
  SOFTWARE_ACCESS
  HR_QUERY
  FACILITIES
  OTHER
}

/// How a service request was raised: with the form, or through the chat assistant. A label for the person's own history; it
/// changes no routing and no permission.
enum RequestChannel {
  FORM
  CHAT
}

/// How a chat draft ended, for people reading the record: it worked, the model's answer was unusable, it timed out, or the
/// AI service could not be used at all.
enum ChatDraftOutcome {
  OK
  INVALID_OUTPUT
  TIMEOUT
  UNAVAILABLE
}

/// Machine-readable cause of a failed chat draft, for counting and alerting later.
enum AiErrorCode {
  AI_UNREACHABLE
  AI_TIMEOUT
  AI_AUTH
  AI_RATE_LIMITED
  AI_MODEL_ERROR
  AI_INVALID_OUTPUT
  AI_REJECTED_BY_BACKEND
  AI_BAD_RESPONSE
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum OwnerType {
  DEPARTMENT
  MANAGER
}

enum OnboardingInstanceStatus {
  ACTIVE
  COMPLETED
}

enum OnboardingTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ───────────── Shared ─────────────

model Department {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  name   String  @unique
  headId String? @map("head_id") @db.Uuid

  head              User?             @relation("DepartmentHead", fields: [headId], references: [id])
  members           User[]            @relation("DepartmentMembers")
  requestCategories RequestCategory[]
  serviceRequests   ServiceRequest[]
  templateTasks     TemplateTask[]
  onboardingTasks   OnboardingTask[]
  chatDrafts        ChatDraft[]       @relation("ChatDraftDepartment")

  @@index([headId])
  @@map("departments")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  employeeCode String     @unique @map("employee_code")
  fullName     String     @map("full_name")
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role
  country      Country
  departmentId String     @map("department_id") @db.Uuid
  managerId    String?    @map("manager_id") @db.Uuid
  jobTitle     String     @map("job_title")
  joiningDate  DateTime   @map("joining_date") @db.Date
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")

  department Department @relation("DepartmentMembers", fields: [departmentId], references: [id])
  manager    User?      @relation("Reporting", fields: [managerId], references: [id])
  reports    User[]     @relation("Reporting")

  headOf              Department[]         @relation("DepartmentHead")
  submittedRequests   ServiceRequest[]     @relation("Requester")
  chatDrafts          ChatDraft[]
  assignedRequests    ServiceRequest[]     @relation("RequestAssignee")
  requestEvents       RequestEvent[]
  requestComments     RequestComment[]
  createdTemplates    OnboardingTemplate[]
  onboardingInstances OnboardingInstance[]
  assignedTasks       OnboardingTask[]     @relation("TaskAssignee")
  completedTasks      OnboardingTask[]     @relation("TaskCompletedBy")

  @@index([managerId])
  @@index([departmentId, status])
  @@index([country])
  @@map("users")
}

// ───────────── Module A — Service Requests ─────────────

model RequestCategory {
  id                   String              @id @default(uuid()) @db.Uuid
  code                 RequestCategoryCode @unique
  name                 String
  handlingDepartmentId String              @map("handling_department_id") @db.Uuid

  handlingDepartment Department       @relation(fields: [handlingDepartmentId], references: [id])
  requests           ServiceRequest[]
  chatDrafts         ChatDraft[]

  @@map("request_categories")
}

model ServiceRequest {
  id                   String          @id @default(uuid()) @db.Uuid
  // Generated by the database from a sequence (see the constraints migration): SR-1001, SR-1002, …
  reference            String          @unique @default(dbgenerated("('SR-'::text || (nextval('service_request_ref_seq'::regclass))::text)"))
  requesterId          String          @map("requester_id") @db.Uuid
  categoryId           String          @map("category_id") @db.Uuid
  handlingDepartmentId String          @map("handling_department_id") @db.Uuid
  assigneeId           String?         @map("assignee_id") @db.Uuid
  title                String
  description          String
  priority             RequestPriority
  status               RequestStatus   @default(SUBMITTED)
  channel              RequestChannel  @default(FORM)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  requester          User             @relation("Requester", fields: [requesterId], references: [id])
  category           RequestCategory  @relation(fields: [categoryId], references: [id])
  handlingDepartment Department       @relation(fields: [handlingDepartmentId], references: [id])
  assignee           User?            @relation("RequestAssignee", fields: [assigneeId], references: [id])
  events             RequestEvent[]
  comments           RequestComment[]

  @@index([requesterId, createdAt(sort: Desc)])
  @@index([assigneeId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status])
  @@map("service_requests")
}

model RequestEvent {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  fromStatus RequestStatus? @map("from_status")
  toStatus   RequestStatus  @map("to_status")
  actorId    String         @map("actor_id") @db.Uuid
  assigneeId String?        @map("assignee_id") @db.Uuid
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User           @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_events")
}

model RequestComment {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_comments")
}

// ───────────── Module B — Onboarding ─────────────

model OnboardingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User                 @relation(fields: [createdById], references: [id])
  tasks     TemplateTask[]
  instances OnboardingInstance[]

  @@map("onboarding_templates")
}

model TemplateTask {
  id                String    @id @default(uuid()) @db.Uuid
  templateId        String    @map("template_id") @db.Uuid
  title             String
  description       String
  ownerType         OwnerType @map("owner_type")
  ownerDepartmentId String?   @map("owner_department_id") @db.Uuid
  offsetDays        Int       @map("offset_days")
  deadlineLabel     String    @map("deadline_label")
  dependsOnId       String?   @map("depends_on_id") @db.Uuid
  sortOrder         Int       @map("sort_order")

  template        OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ownerDepartment Department?        @relation(fields: [ownerDepartmentId], references: [id])
  dependsOn       TemplateTask?      @relation("TemplateTaskDependency", fields: [dependsOnId], references: [id])
  dependents      TemplateTask[]     @relation("TemplateTaskDependency")

  @@index([templateId, sortOrder])
  @@index([dependsOnId])
  @@map("template_tasks")
}

model OnboardingInstance {
  id         String                   @id @default(uuid()) @db.Uuid
  employeeId String                   @map("employee_id") @db.Uuid
  templateId String                   @map("template_id") @db.Uuid
  startDate  DateTime                 @map("start_date") @db.Date
  status     OnboardingInstanceStatus @default(ACTIVE)
  createdAt  DateTime                 @default(now()) @map("created_at")

  employee User               @relation(fields: [employeeId], references: [id])
  template OnboardingTemplate @relation(fields: [templateId], references: [id])
  tasks    OnboardingTask[]

  // Partial unique index "one ACTIVE instance per employee" lives in the SQL migration.
  @@index([employeeId])
  @@map("onboarding_instances")
}

model OnboardingTask {
  id                String               @id @default(uuid()) @db.Uuid
  instanceId        String               @map("instance_id") @db.Uuid
  title             String
  description       String
  ownerType         OwnerType            @map("owner_type")
  ownerDepartmentId String?              @map("owner_department_id") @db.Uuid
  assigneeId        String?              @map("assignee_id") @db.Uuid
  dueDate           DateTime             @map("due_date") @db.Date
  status            OnboardingTaskStatus @default(NOT_STARTED)
  dependsOnId       String?              @map("depends_on_id") @db.Uuid
  completedAt       DateTime?            @map("completed_at")
  completedById     String?              @map("completed_by_id") @db.Uuid
  sortOrder         Int                  @map("sort_order")

  instance        OnboardingInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  ownerDepartment Department?        @relation(fields: [ownerDepartmentId], references: [id])
  assignee        User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedBy     User?              @relation("TaskCompletedBy", fields: [completedById], references: [id])
  dependsOn       OnboardingTask?    @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependents      OnboardingTask[]   @relation("TaskDependency")

  @@index([instanceId, sortOrder])
  @@index([dependsOnId])
  @@map("onboarding_tasks")
}

/// One row per call to POST /requests/chat-draft, written by the backend for every outcome. For developers: who asked, from
/// where, how it went and, on failure, why. NEVER the message text (only its length).
model ChatDraft {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  /// The page the chat head was opened on, for example /requests.
  page          String
  ip            String?
  userAgent     String?          @map("user_agent")
  /// Sent to the AI service as X-Request-Id; search its logs for it.
  requestId     String           @unique @map("request_id") @db.Uuid
  outcome       ChatDraftOutcome
  errorCode     AiErrorCode?     @map("error_code")
  /// The cause in a few words. No personal data, no message text.
  error         String?
  /// The AI service's redacted traceback, or the backend's own detail. Never message text.
  errorDetail   String?          @map("error_detail")
  attempts      Int?
  model         String?
  latencyMs     Int?             @map("latency_ms")
  categoryId    String?          @map("category_id") @db.Uuid
  departmentId  String?          @map("department_id") @db.Uuid
  priority      RequestPriority?
  confidence    Decimal?         @db.Decimal(3, 2)
  lowConfidence Boolean          @default(false) @map("low_confidence")
  messageChars  Int              @map("message_chars")
  createdAt     DateTime         @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id])
  category   RequestCategory? @relation(fields: [categoryId], references: [id])
  department Department?      @relation("ChatDraftDepartment", fields: [departmentId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("chat_drafts")
}
