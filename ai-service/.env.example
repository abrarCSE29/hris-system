# Names only. Copy to .env and fill in; .env is git-ignored. Never commit a real key.

# Shared secret the backend must send as X-Service-Token. Must match the backend's AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN=

# Google Gemini API key (added by you; used from the drafter task onwards).
GOOGLE_API_KEY=

GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=20
CONFIDENCE_THRESHOLD=0.6

LOG_LEVEL=INFO
# Local debugging only: also logs the prompt and the model's raw reply (this includes the employee's message).
# Must stay false in production.
DEBUG_LOG_PROMPTS=false

# Set to "production" when deployed: turns the interactive API docs off.
APP_ENV=development
