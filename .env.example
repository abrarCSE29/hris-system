# Optional settings for `docker compose up`. Copy this file to .env to change any of them.
# Everything works without a .env file, except the AI assistant, which needs GROQ_API_KEY.

# Your Groq key, for the AI assistant. Leave empty to run without it (the request form still works).
GROQ_API_KEY=

# Password for every demo account (at least 10 characters).
SEED_PASSWORD=Password123!

# Secrets used between the parts of the system. Change them if the system is reachable by other people.
JWT_SECRET=local-demo-secret-change-me-at-least-32-characters
AI_SERVICE_TOKEN=local-demo-token-change-me

# Ports on your computer, if the defaults are already in use.
FRONTEND_PORT=3000
DB_PORT=5433
